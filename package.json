{
  "name": "survixa-disaster-response",
  "version": "1.0.0",
  "description": "AI-Powered Unified Disaster Response Platform breaking agency silos with Next.js, Socket.io, and Prisma ORM",
  "main": "src/server/index.ts",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:next": "next dev",
