# ==============================================================================
# SURVIXA DISASTER RESPONSE PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL - Supabase / Neon / Railway)
# ------------------------------------------------------------------------------
# Supabase Transaction Pooler (Port 6543 with pgbouncer=true):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Neon Serverless Postgres:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require"
#
# Local Development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/survixa_disaster_db?schema=public"

# ------------------------------------------------------------------------------
# 2. AI TRIAGE & MULTIMODAL INTELLIGENCE ENGINE (Google Gemini API)
# ------------------------------------------------------------------------------
# Google AI Studio API key (Supports Gemini 3.5 Flash Interactions API v1beta)
# Obtain your key at: https://aistudio.google.com/apikey
LLM_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ------------------------------------------------------------------------------
# 3. REAL-TIME WEBSOCKET & TELEMETRY GATEWAY (Socket.io)
# ------------------------------------------------------------------------------
# On Vercel frontend, point this to your deployed Render or Railway WebSocket URL:
# e.g., "https://survixa-socket.onrender.com" or "https://survixa-production.up.railway.app"
# For local monolithic development, keep "http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"

# Public site canonical origin for PWA & metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. WEBSOCKET / NODE BACKEND SERVER (Render / Railway Deployment)
# ------------------------------------------------------------------------------
PORT=3000
HOST="0.0.0.0"

# Allowed CORS origins for the WebSocket gateway (comma-separated for multiple origins)
# Example for production: "https://survixa.vercel.app,https://survixa.com"
# Leave empty to allow dynamic origin echo across all preview deployments
CORS_ORIGIN="https://survixa.vercel.app,http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. GEOSPATIAL & SECTOR DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_LATITUDE=37.7749
DEFAULT_LONGITUDE=-122.4194
MAX_DUPLICATE_DISTANCE_KM=0.25
