// Survixa AI-Powered Disaster Response Platform
// Breaking Agency Silos: Unified Command, Citizen Transparency & Multi-Agency Interoperability
// Datasource & Client Generator Configuration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

/// Multi-agency categories breaking institutional silos
enum AgencyType {
  FIRE
  MEDICAL
  POLICE
  NGO
  COAST_GUARD
  CIVIL_DEFENSE
  DISASTER_MANAGEMENT
}

/// Incident lifecycle stages reflecting active crisis pipeline
enum IncidentStatus {
  RECEIVED
  VERIFIED
  ASSIGNED
  EN_ROUTE
  RESOLVED
}

/// Operational classification for triage and specialized asset allocation
enum IncidentCategory {
  FIRE
  FLOOD
  EARTHQUAKE
  MEDICAL_EMERGENCY
  STRUCTURAL_COLLAPSE
  HAZMAT
  SEARCH_AND_RESCUE
  CYCLONE_STORM
  OTHER
}

/// Real-time readiness of multi-agency field units
enum UnitStatus {
  AVAILABLE
  DISPATCHED
  ON_SCENE
  RETURNING
  STANDBY
  OFFLINE
}

/// Information access tier for status update logs
enum UpdateVisibility {
  PUBLIC               // Streamed to reporting citizen via the live feedback loop
  INTERNAL_CONFIDENTIAL // Restricted to multi-agency commanders & dispatchers
}

// ==========================================
// MODELS
// ==========================================

/// Central Incident model aggregating multilingual citizen telemetry,
/// AI deduplication, severity grading, and multi-agency response state.
model Incident {
  id               String           @id @default(uuid())
  trackingCode     String           @unique // Citizen access token for feedback loop (e.g., SVX-8F2A)
  
  // Multilingual Ingestion & AI Normalization
  originalLanguage String           // Detected ISO code (e.g. 'es', 'hi', 'uk', 'ar', 'zh', 'en')
  rawContent       String           @db.Text // Citizen original submission in their native language
  translatedText   String           @db.Text // AI-translated operational text for standardized dispatch
  
  // Geospatial Telemetry
  latitude         Float            // Precise GPS latitude
  longitude        Float            // Precise GPS longitude
  locationName     String?          // Reverse-geocoded address, road intersection, or landmark
  city             String?
  district         String?

  // AI Triage & Assessment Metrics
  severityScore    Int              // Normalized urgency rating on a scale from 1 (minor) to 10 (catastrophic)
  credibilityScore Float            // Confidence score (0.00 to 1.00) based on NLP corroboration and telemetry
  duplicateCount   Int              @default(0) // Clustered reports representing the same ground incident
  
  // Lifecycle & Classification
  status           IncidentStatus   @default(RECEIVED)
  category         IncidentCategory @default(OTHER)
  
  // AI Extracted Intelligence
  aiSummary        String?          @db.Text // 2-sentence tactical briefing generated by AI for responders
  hazardsIdentified String[]        @default([]) // e.g. ["Live Power Lines", "Gas Leak", "Submerged Road"]
  estimatedVictims Int?             @default(0)

  // Citizen Privacy & Attribution
  reporterName     String?
  reporterPhone    String?          // Masked / hashed for privacy compliance
  mediaUrls        String[]         @default([]) // Attached photos, audio transcripts, or drone imagery

  // Deduplication & Spatial Clustering
  parentIncidentId String?
  parentIncident   Incident?        @relation("IncidentClusters", fields: [parentIncidentId], references: [id], onDelete: SetNull)
  clusteredReports Incident[]       @relation("IncidentClusters")

  // Cross-Agency Orchestration Relations
  dispatches       UnitDispatch[]   // Joint task forces assigned across Fire, Medical, Police, NGO
  statusLogs       StatusUpdateLog[] // Citizen feedback loop and chronological audit trail

  // Timestamps
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  resolvedAt       DateTime?

  @@index([latitude, longitude], name: "idx_incident_spatial")
  @@index([status, severityScore(sort: Desc)], name: "idx_incident_priority")
  @@index([category], name: "idx_incident_category")
  @@index([createdAt], name: "idx_incident_timeline")
  @@map("incidents")
}

/// RescueUnit model representing physical responder assets across Fire, Medical,
/// Police, and NGOs with real-time GPS telemetry and availability tracking.
model RescueUnit {
  id              String         @id @default(uuid())
  callsign        String         @unique // e.g. "ENGINE-41", "MEDIC-09", "POLICE-TAC-3", "RED-CROSS-ALPHA"
  agencyType      AgencyType     // Fire, Medical, Police, NGO
  department      String         // e.g., "Metro Fire District 4", "Mercy Trauma EMS", "UNICEF Disaster Relief"
  
  // Live GPS Telemetry
  latitude        Float          // Real-time GPS latitude
  longitude       Float          // Real-time GPS longitude
  altitude        Float?         // Altitude in meters (critical for drone / aviation / high-rise units)
  speed           Float?         // Current velocity in km/h
  heading         Float?         // Heading in degrees (0-359)
  lastGpsUpdate   DateTime       @default(now())

  // Unit State & Capacity
  availability    UnitStatus     @default(AVAILABLE)
  personnelCount  Int            @default(2)
  capabilities    String[]       @default([]) // e.g. ["Water Rescue", "Heavy Extrication", "Hazmat Level B"]
  contactChannel  String?        // Radio frequency or encrypted digital comms channel
  
  // Relations
  dispatches      UnitDispatch[]
  statusLogs      StatusUpdateLog[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([agencyType, availability], name: "idx_unit_agency_status")
  @@index([latitude, longitude], name: "idx_unit_location")
  @@map("rescue_units")
}

/// UnitDispatch model breaking agency silos by coordinating multi-agency
/// assets (e.g. Fire + Police + Medical + NGO) attached to a single incident.
model UnitDispatch {
  id           String      @id @default(uuid())
  incidentId   String
  incident     Incident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  rescueUnitId String
  rescueUnit   RescueUnit  @relation(fields: [rescueUnitId], references: [id], onDelete: Cascade)
  
  assignedRole String?     // e.g. "Perimeter Containment", "Primary Extrication", "Triage Staging"
  dispatchedAt DateTime    @default(now())
  arrivedAt    DateTime?
  clearedAt    DateTime?

  @@unique([incidentId, rescueUnitId], name: "uniq_incident_unit_assignment")
  @@index([incidentId], name: "idx_dispatch_incident")
  @@index([rescueUnitId], name: "idx_dispatch_unit")
  @@map("unit_dispatches")
}

/// StatusUpdateLog model powering the real-time Citizen Feedback Loop
/// and maintaining an immutable multi-agency incident action timeline.
model StatusUpdateLog {
  id            String           @id @default(uuid())
  incidentId    String
  incident      Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  rescueUnitId  String?
  rescueUnit    RescueUnit?      @relation(fields: [rescueUnitId], references: [id], onDelete: SetNull)

  status        IncidentStatus   // Mirroring status transition (RECEIVED -> VERIFIED -> ASSIGNED -> EN_ROUTE -> RESOLVED)
  
  // Citizen Transparency Message
  message       String           @db.Text // e.g., "Rescue Unit MEDIC-09 dispatched. Estimated arrival in 4 minutes."
  
  // Inter-Agency Command Intelligence
  internalNotes String?          @db.Text // Tactical notes visible only inside the Command Center
  visibility    UpdateVisibility @default(PUBLIC)
  
  sourceAgency  AgencyType?      // Agency publishing the update (e.g., FIRE, MEDICAL, POLICE, NGO)
  operatorId    String?          // Dispatcher or automated AI agent identifier
  
  createdAt     DateTime         @default(now())

  @@index([incidentId, createdAt(sort: Asc)], name: "idx_status_incident_timeline")
  @@index([visibility], name: "idx_status_visibility")
  @@map("status_update_logs")
}
